BOT_TOKEN=
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://autohistory:replace-with-a-long-random-password@localhost:5432/autohistory
MAX_USERS=50
MAX_CARS=3
MAX_RECORDS=500
PHOTO_MAX_BYTES=5242880
PDF_MAX_BYTES=10485760
REMIND_DAYS=7
REMIND_KM=500
ODOMETER_REFRESH_DAYS=30
FSM_TTL_MIN=30
SEND_HOUR_FROM=9
SEND_HOUR_TO=20
PDF_TMP_DIR=tmp/reports
DELETION_JOURNAL_DIR=tmp/deletions
LOG_LEVEL=INFO
